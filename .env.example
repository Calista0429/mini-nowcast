# Any OpenAI-compatible chat API works. Examples:
#
#   DeepSeek        LLM_BASE_URL=https://api.deepseek.com              LLM_MODEL=deepseek-chat
#   OpenAI          LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini
#   Moonshot (Kimi) LLM_BASE_URL=https://api.moonshot.cn/v1            LLM_MODEL=moonshot-v1-8k
#   Qwen/DashScope  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   Zhipu (GLM)     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-plus
#   Groq            LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter      LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=anthropic/claude-sonnet-4.5
#   Ollama (local)  LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=qwen2.5:14b   LLM_API_KEY=ollama
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Set to "off" for providers without JSON mode; the prompt then asks for JSON instead.
# LLM_JSON_MODE=on
